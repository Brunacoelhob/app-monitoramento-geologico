# Copie para .env e preencha: cp .env.example .env
# O .env NUNCA deve ser commitado (esta no .gitignore).

# --- Banco PostgreSQL ---
DB_USER=postgres
DB_PASS=troque-esta-senha
DB_NAME=iot_db
# Porta do banco NA SUA MAQUINA (se a 5432 estiver ocupada, use outra, ex.: 55432)
DB_PORT=5432

# Usada pelo Prisma quando o backend roda fora do Docker (npm run start:dev)
# Se a senha tiver caracteres especiais, codifique-os (ex.: @ vira %40)
DATABASE_URL=postgresql://postgres:troque-esta-senha@127.0.0.1:5432/iot_db

# --- Backend ---
PORTA_API=3000
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=gere-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRA_EM=1h
# Origens autorizadas a chamar a API pelo navegador, separadas por virgula
CORS_ORIGENS=http://localhost:8080,http://localhost:4200

# --- Usuarios iniciais (criados com: npm run criar-usuarios) ---
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque-por-uma-senha-forte
VISUALIZADOR_EMAIL=visualizador@exemplo.com
VISUALIZADOR_SENHA=troque-por-outra-senha-forte

# --- Modulo de sismos (valores iniciais; veja docs/regras-de-negocio-sismos.md) ---
# Desligue as tarefas em segundo plano (USGS, simulador, alertas) com false
SISMOS_AGENDADOR=true
SISMOS_MAGNITUDE_MINIMA=4.0
# Magnitude minima importada para o resto do mundo (o Japao usa a de cima)
SISMOS_MAGNITUDE_MINIMA_MUNDO=4.5
SISMOS_INTERVALO_USGS_MIN=10
SISMOS_DIAS_CARGA_INICIAL=30
SISMOS_DISTANCIA_PROXIMA_KM=300
SISMOS_REPLICA_KM=50
SISMOS_REPLICA_HORAS=24
SISMOS_ENCERRAMENTO_ATENCAO_HORAS=72
SISMOS_SEM_COMUNICACAO_MIN=15
SISMOS_ATRASO_MAXIMO_HORAS=24
SISMOS_RETENCAO_SISMOGRAFO_DIAS=30

# --- Notificacoes (opcional) ---
# Quando definido, cada alerta ALTO ou CRITICO e enviado por POST (JSON) para esta URL:
# funciona com webhooks do Slack, Discord e Teams. Deixe vazio para desligar.
ALERTA_WEBHOOK_URL=

# --- Testes de integracao (npm run test:e2e no backend) ---
# Banco EXCLUSIVO para testes: o nome precisa conter "test". As tabelas sao zeradas a cada execucao.
DATABASE_URL_TESTE=postgresql://postgres:troque-a-senha@127.0.0.1:55432/iot_test
