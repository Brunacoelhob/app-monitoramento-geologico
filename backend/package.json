{
  "name": "backend-iot",
  "version": "1.0.0",
  "private": true,
  "description": "API do sistema de monitoramento IoT (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "prisma:gerar": "prisma generate",
    "prisma:migrar": "dotenv -e ../.env -- prisma migrate deploy",
    "prisma:migrar:dev": "dotenv -e ../.env -- prisma migrate dev",
    "criar-usuarios": "dotenv -e ../.env -- ts-node scripts/criar-usuarios.ts",
    "importar-csv": "dotenv -e ../.env -- ts-node scripts/importar-csv.ts",
    "postinstall": "prisma generate",
    "sismos:semear": "dotenv -e ../.env -- ts-node scripts/semear-sismos.ts",
    "sismos:testar-regras": "dotenv -e ../.env -- ts-node --transpile-only scripts/testar-regras-alertas.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "dotenv-cli": "^7.4.4",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
